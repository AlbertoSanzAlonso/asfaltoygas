# Supabase Configuration
# Dejar vacío hasta configurar el nuevo proyecto (el legacy aoyafhjpgmxcygqnklvl queda bloqueado en código)
# SUPABASE_DB_PASSWORD=your-database-password
# DATABASE_URL=postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-1-eu-central-1.pooler.supabase.com:6543/postgres
# VITE_SUPABASE_URL=https://your-new-project-id.supabase.co
# VITE_SUPABASE_ANON_KEY=your-anon-public-key
# SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Insforge API Configuration
# Used for data synchronization and products database
VITE_INSFORGE_URL=https://your-insforge-url
VITE_INSFORGE_API_KEY=your-insforge-api-key

# AI Agents Configuration
# Keys for ChatGPT / AI Assistant features
VITE_OPENAI_API_KEY=your-openai-api-key
VITE_GROQ_API_KEY=your-groq-api-key

# Email (DonDominio SMTP — info@asfaltoygas.es)
SMTP_HOST=smtp.dondominio.com
SMTP_PORT=587
SMTP_USER=info@asfaltoygas.es
SMTP_PASS=tu-contraseña-del-correo
MAIL_FROM=info@asfaltoygas.es

# Aviso de nuevo pedido al propietario (NO uses info@: ese es solo el remitente SMTP)
ADMIN_ORDER_EMAIL=asfaltoygasatcliente@gmail.com
SITE_URL=https://www.asfaltoygas.es

# Google Search Console (verificación por meta tag en la home)
# VITE_GOOGLE_SITE_VERIFICATION=tu-codigo-de-google

# Redsys / Getnet Payment Gateway (Spain)
# Del correo TPV Getnet (TEST): FUC, terminal 001 y clave de firma.
# Misma FUC en prod; al "Pasar a producción" Getnet da otra clave SHA.
VITE_REDSYS_SECRET_KEY=your-redsys-sha256-secret-key
VITE_REDSYS_COMMERCE_NUMBER=your-merchant-fuc-number
VITE_REDSYS_TERMINAL_NUMBER=001

# true = URL de pruebas (sis-t.redsys.es) + botón "Pago test" + Nacex TEST.
# false = URL de producción (sis.redsys.es). Requiere clave SHA de producción.
# VITE_ENABLE_TEST_CHECKOUT=true

# Nacex Shipping Integration (Web Service WS — https://pda.nacex.com/nacex_ws)
# NACEX_USER=ASFALTOYGASATCLIENTE@GMAIL.COM
# NACEX_USER_TEST=ASFALTOYGASATCLIENTE@GMAIL._T
# NACEX_PASSWORD=clave-md5-proporcionada-por-nacex
# NACEX_AGENCIA=2924
# NACEX_CLIENTE=00485
# NACEX_CP_RECOGIDA=29631
# NACEX_NOMBRE_RECOGIDA=Asfalto y Gas
# NACEX_DIR_RECOGIDA=Calle Las Flores, 20
# NACEX_POBLACION_RECOGIDA=Benalmadena
# NACEX_TEL_RECOGIDA=642181821
