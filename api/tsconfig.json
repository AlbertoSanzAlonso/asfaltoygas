{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "types": ["node"],
    "typeRoots": ["../node_modules/@types"],
    "skipLibCheck": true,
    "noEmit": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": false
  },
  "include": [
    "./**/*.ts",
    "./**/*.d.ts",
    "../process-env.d.ts",
    "../src/types/**/*.ts",
    "../src/lib/brand.ts",
    "../src/lib/env.ts",
    "../src/lib/mailTransport.ts",
    "../src/lib/siteUrl.ts",
    "../src/lib/orderContact.ts",
    "../src/lib/orderEmailHtml.ts",
    "../src/lib/orderPayment.ts",
    "../src/lib/orderPricing.ts",
    "../src/lib/emails/**/*.ts"
  ]
}
